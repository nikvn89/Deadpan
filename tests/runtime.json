{
 "contract": "MeantIt",
 "wallets": {
  "A": "creator",
  "B": "first commenter",
  "C": "second commenter"
 },
 "methods": {
  "open_jar": [
   "title",
   "tip_wei"
  ],
  "fund_allowance": [],
  "comment": [
   "jar_id",
   "text"
  ],
  "close_jar": [
   "jar_id"
  ],
  "withdraw_allowance": [
   "amount"
  ],
  "withdraw_earnings": [],
  "get_jar": [
   "jar_id"
  ],
  "get_reply": [
   "jar_id",
   "index"
  ],
  "get_replies": [
   "jar_id",
   "offset",
   "limit"
  ],
  "get_balances": [
   "wallet"
  ]
 },
 "rows": [
  {
   "n": 1,
   "wallet": "A",
   "method": "open_jar",
   "args": [
    "Release notes for version 2.4 of a photo app",
    1000000000000000
   ],
   "save": {
    "name": "J1",
    "payload": [
     "L:MEANT_IT:JAR:V1|",
     "sender",
     "L:|",
     "len(norm(A0))",
     "L:|",
     "norm(A0)"
    ]
   },
   "expect": "J1 OPEN, tip 1000000000000000 wei"
  },
  {
   "n": 2,
   "calls": [
    {
     "wallet": "A",
     "method": "open_jar",
     "args": [
      "Release notes for version 2.5 of a photo app",
      1000000000000000
     ],
     "save": {
      "name": "J2",
      "payload": [
       "L:MEANT_IT:JAR:V1|",
       "sender",
       "L:|",
       "len(norm(A0))",
       "L:|",
       "norm(A0)"
      ]
     }
    },
    {
     "wallet": "A",
     "method": "open_jar",
     "args": [
      "Release notes for version 2.6 of a photo app",
      1000000000000000
     ],
     "save": {
      "name": "J3",
      "payload": [
       "L:MEANT_IT:JAR:V1|",
       "sender",
       "L:|",
       "len(norm(A0))",
       "L:|",
       "norm(A0)"
      ]
     }
    }
   ],
   "expect": "J2 and J3 OPEN (2 transactions)"
  },
  {
   "n": 3,
   "wallet": "B",
   "method": "fund_allowance",
   "args": [],
   "value": 10000000000000000,
   "expect": "get_balances(B): allowance 10000000000000000 (0.01 GEN)"
  },
  {
   "n": 4,
   "wallet": "B",
   "method": "comment",
   "args": [
    "$J1",
    "Took me ten seconds to find the new export button. Lovely work."
   ],
   "expect": "SINCERE_PRAISE; B allowance 9000000000000000, A earnings 1000000000000000"
  },
  {
   "n": 5,
   "wallet": "B",
   "method": "comment",
   "args": [
    "$J2",
    "Took me ten minutes to find the new export button. Lovely work."
   ],
   "expect": "NOT_PRAISE; balances unchanged: B allowance 9000000000000000, A earnings 1000000000000000"
  },
  {
   "n": 6,
   "wallet": "B",
   "method": "comment",
   "args": [
    "$J1",
    "Nice."
   ],
   "revert": "You have already replied to this jar",
   "expect": "revert *You have already replied to this jar*"
  },
  {
   "n": 7,
   "wallet": "A",
   "method": "comment",
   "args": [
    "$J1",
    "Nice."
   ],
   "revert": "The creator cannot reply to their own jar",
   "expect": "revert *The creator cannot reply to their own jar*"
  },
  {
   "n": 8,
   "wallet": "C",
   "method": "comment",
   "args": [
    "$J3",
    "I expected the worst from a big redesign, and you somehow beat that."
   ],
   "revert": "Fund your allowance before replying",
   "expect": "revert *Fund your allowance before replying* (C has not funded)"
  },
  {
   "n": 9,
   "calls": [
    {
     "wallet": "C",
     "method": "fund_allowance",
     "args": [],
     "value": 10000000000000000
    },
    {
     "wallet": "C",
     "method": "comment",
     "args": [
      "$J3",
      "I expected the worst from a big redesign, and you somehow beat that."
     ]
    }
   ],
   "expect": "NOT_PRAISE; C allowance stays 10000000000000000 (2 transactions)"
  },
  {
   "n": 10,
   "wallet": "B",
   "method": "comment",
   "args": [
    "$J3",
    "I expected the worst from a big redesign, and it is the best version yet."
   ],
   "expect": "SINCERE_PRAISE on the same jar as row 9, another writer; B allowance 8000000000000000, A earnings 2000000000000000"
  },
  {
   "n": 11,
   "wallet": "A",
   "method": "withdraw_earnings",
   "args": [],
   "expect": "0.002 GEN reaches wallet A; A earnings 0"
  },
  {
   "n": 12,
   "wallet": "B",
   "method": "withdraw_allowance",
   "args": [
    8000000000000000
   ],
   "expect": "0.008 GEN reaches wallet B; B allowance 0"
  },
  {
   "n": 13,
   "kind": "view",
   "method": "get_balances",
   "args": [
    "$C"
   ],
   "expect": "read: C allowance 10000000000000000, earnings 0"
  }
 ],
 "caps": [
  {
   "label": "a title at the 80-character cap and the largest tip",
   "method": "open_jar",
   "args": [
    "x*80",
    1000000000000000000
   ]
  },
  {
   "label": "a reply at the 200-character cap",
   "method": "comment",
   "args": [
    "$J1",
    "x*200"
   ]
  }
 ]
}
